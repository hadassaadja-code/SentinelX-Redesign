# ---------- SentinelX : configuration (copier vers .env) ----------
# Mode démonstration (par défaut, sans rien configurer) : SQLite, file en mémoire, e-mails journalisés, paiement simulé.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# URL publique (liens dans les e-mails, retours de paiement)
APP_URL=https://sentinelx.exemple.com
# Derrière un reverse proxy (Nginx, Traefik) : prend l'adresse IP réelle dans X-Forwarded-For
TRUST_PROXY=1

# Secrets (générés automatiquement dans server/.jwt-secret et server/.encryption-key si absents)
JWT_SECRET=
ENCRYPTION_KEY=

# Base de données : PostgreSQL en production (voir docker-compose.yml). Sans DATABASE_URL : SQLite local.
DATABASE_URL=postgresql://sentinelx:motdepasse@postgres:5432/sentinelx
POSTGRES_PASSWORD=motdepasse

# File de tâches : Redis + BullMQ. Sans REDIS_URL : exécution dans le processus du serveur.
REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY=2
# all | api | worker
PROCESS_ROLE=all

# Courrier (section 11). Sans SMTP_URL, les e-mails sont journalisés et les liens affichés dans l'interface.
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.com:465
MAIL_FROM=SentinelX <no-reply@exemple.com>
MAIL_DEV_EXPOSE_LINKS=false

# Paiement Stripe (12.2). Sans clé : changement de formule immédiat sans paiement (démonstration).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_BUSINESS=price_...

# Comptes promus Super Administrateur au démarrage (séparés par des virgules)
SUPERADMIN_EMAILS=admin@exemple.com
REGISTRATIONS_OPEN=true
REQUIRE_EMAIL_VERIFICATION=false

# Moteurs
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_TIMEOUT_MS=30000
# Laboratoire uniquement (jamais en production) : autorise les cibles sur réseaux privés
ALLOW_PRIVATE_TARGETS=false
RATE_LIMIT_API=300
RATE_LIMIT_AUTH=15
SESSION_DAYS=7
SESSION_IDLE_MINUTES=720
